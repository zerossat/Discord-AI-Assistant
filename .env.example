# =====================================================================
#  Discord AI Assistant — environment variables
#  Copy this file to `.env` and fill in the values.
#  docker-compose reads `.env` automatically.
#  NOTE: keep real secrets only in `.env` (gitignored), never in this file.
# =====================================================================

# ---------- Discord ----------
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_CLIENT_SECRET=your-application-client-secret
# Optional: register slash commands instantly to ONE guild while developing.
# Leave empty to register globally (can take up to ~1h to propagate).
DISCORD_DEV_GUILD_ID=1370371189553496165

# ---------- Gemini (Google AI) ----------
# Get a key at https://aistudio.google.com/app/apikey
# Provide a single key, and/or a comma-separated list the bot rotates through
# on rate limits (429). At least one of the two is required.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-2.5-flash
# Models tried in order when the primary is throttled or unavailable.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# ---------- Database / Cache ----------
# Inside docker-compose use the service names (mongo / redis).
# For local dev outside Docker use localhost.
MONGODB_URI=mongodb://mongo:27017/discord-ai
REDIS_URL=redis://redis:6379

# ---------- Bot HTTP API (Express + Swagger) ----------
API_PORT=4000
API_BASE_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Memory system ----------
# Recent messages kept per user/guild conversation context.
MEMORY_MAX_MESSAGES=20
# Redis TTL (seconds) for cached conversation context.
MEMORY_CACHE_TTL=3600

# ---------- Dashboard (Next.js / NextAuth) ----------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Server-side URL the dashboard uses to reach the bot API.
# In docker-compose this is the bot service name.
BOT_API_URL=http://bot:4000
NEXT_PUBLIC_APP_NAME=Discord AI Assistant
# Dashboard admins: comma-separated Discord IDs allowed to edit/delete.
# Leave empty so anyone who logs in can manage.
ADMIN_IDS=

# ---------- Runtime ----------
NODE_ENV=development
LOG_LEVEL=info
