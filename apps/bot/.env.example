# Bot-only env (for running `pnpm --filter @daa/bot dev` standalone).
# In the monorepo, prefer the single root .env — the bot loads it automatically.

DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_DEV_GUILD_ID=

# Single key, and/or a comma-separated list rotated on rate limits (429).
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key_one,key_two,key_three
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

MONGODB_URI=mongodb://localhost:27017/discord-ai
REDIS_URL=redis://localhost:6379

API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

MEMORY_MAX_MESSAGES=20
MEMORY_CACHE_TTL=3600

NODE_ENV=development
LOG_LEVEL=info
