# Dashboard-only env (for running `pnpm --filter @daa/dashboard dev` standalone).
# In the monorepo, prefer the single root .env — next.config loads it automatically.

DISCORD_CLIENT_ID=your-application-client-id
DISCORD_CLIENT_SECRET=your-oauth-client-secret

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-another-long-random-string

# Where the dashboard reaches the bot API (server-side).
BOT_API_URL=http://localhost:4000
# Must match the bot's JWT_SECRET so the dashboard can call protected endpoints.
JWT_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_APP_NAME=Discord AI Assistant
